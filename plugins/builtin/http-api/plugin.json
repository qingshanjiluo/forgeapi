{
  "name": "http-api",
  "version": "0.1.0",
  "description": "公开 HTTP/JSON API 封装：配置 URL、方法、头、参数映射，统一输出",
  "type": "aggregate",
  "permissions": ["net"],
  "tags": ["api", "json", "rest"],
  "schema": {
    "type": "object",
    "properties": {
      "endpoint": { "type": "string", "description": "API 地址（可含 ${param} 占位）" },
      "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE"], "default": "GET" },
      "query": { "type": "object", "description": "查询参数对象" },
      "body": { "type": "object", "description": "请求体（非 GET）" },
      "headers": { "type": "object", "description": "自定义请求头" },
      "jsonpath": { "type": "string", "description": "从响应中取数组的 JSONPath，如 $.data.items" },
      "fields": { "type": "array", "items": { "type": "string" }, "description": "输出字段名" }
    },
    "required": ["endpoint"]
  },
  "sources": [
    {
      "name": "api",
      "type": "api",
      "url": "${endpoint}",
      "method": "${method}",
      "params": "${query}",
      "headers": "${headers}",
      "body": "${body}",
      "jsonpath": "${jsonpath}"
    }
  ],
  "merge": { "strategy": "concat" }
}
