# 示例：条件步骤 + 失败策略
# 用法：forge pipeline examples/conditional.json -p '{"query":"rust","detail":true}'
{
  "name": "conditional-demo",
  "description": "演示 when 条件、forEach、onError 三种策略",
  "onError": "abort",
  "input": { "query": "rust", "detail": true, "limit": 2 },
  "steps": [
    {
      "id": "search",
      "plugin": "hn-search",
      "params": { "query": "${input.query}", "limit": 3 }
    },
    {
      "id": "detail",
      "plugin": "webpage",
      "when": "${input.detail}",
      "forEach": "${steps.search.data.results}",
      "limit": "${input.limit}",
      "concurrency": 2,
      "onError": "continue",
      "pick": "title",
      "params": { "url": "${item.链接}" }
    },
    {
      "id": "rate",
      "plugin": "exchange-rate",
      "params": { "from": "USD", "to": "CNY" }
    }
  ],
  "output": {
    "query": "${input.query}",
    "found": "${steps.search.data.total}",
    "titles": "${steps.detail.items}",
    "usdCny": "${steps.rate.data.results[0].rates.CNY}"
  }
}